# Copy this file to .env and fill in the two required values.
# Real environment variables win over anything set here.

# Required ---------------------------------------------------------------
DISCORD_TOKEN=
GEMINI_API_KEY=
# Older Google AI Studio keys may be named this instead:
# GOOGLE_API_KEY=

# Model / personality ----------------------------------------------------
GEMINI_MODEL=gemini-3.8-flash
# PERSONA=You are a warm, witty Discord companion. Keep replies short.
TEMPERATURE=0.8
MAX_TOKENS=512
MEMORY_TURNS=8

# Voice ------------------------------------------------------------------
# auto = edge-tts if installed, otherwise gtts
TTS_ENGINE=auto
# Any Edge ShortName or one of: ava, andrew, emma, brian, jenny, guy, aria,
# sonia, ryan, natasha, clara, neerja, elvira, denise, katja, nanami, francisca
TTS_VOICE=en-US-AvaNeural
# Rate/pitch only affect edge-tts, e.g. +10%, -15Hz
TTS_RATE=+0%
TTS_PITCH=+0Hz
# Gemini TTS only (TTS_ENGINE=gemini): voice + acting style
GEMINI_TTS_VOICE=Kore
TTS_STYLE=
# gTTS only
TTS_LANG=en

# Behaviour --------------------------------------------------------------
PREFIX=!
# Reply to every message in this channel id (0 = off)
SPECIAL_CHANNEL_ID=0
# Voice channel idle timeout, in seconds
IDLE_LEAVE_SECONDS=300
# Let anyone use !model/!voice/!persona instead of only server managers
ALLOW_EVERYONE_TO_CONFIGURE=false
# Your Discord user id, so you can configure the bot anywhere
OWNER_ID=0

# Only needed if ffmpeg is not on PATH and not next to this script
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
